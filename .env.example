
# AirGuard AI local environment

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=https://airguard-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgresql://airguard:airguard@localhost:5432/airguard
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001

MQTT_QOS=1
SENSOR_INTERVAL_SECONDS=10
SENSOR_SCENARIO=normal
SENSOR_RANDOM_SEED=740
STALE_AFTER_SECONDS=300
MAX_FUTURE_SKEW_SECONDS=60
PM25_WARNING_THRESHOLD=50
PM25_CRITICAL_THRESHOLD=100
PM25_ALERT_RULE_VERSION=pm25-threshold-v1
PM25_ALERT_CONSECUTIVE_MEASUREMENTS=2
ENVIRONMENT_ALERT_RULE_VERSION=environmental-threshold-v1
# Provisional MVP thresholds; confirm with mentor/operations before real deployment.
AQI_WARNING_THRESHOLD=101
AQI_CRITICAL_THRESHOLD=151
CO2_WARNING_THRESHOLD=1000
CO2_CRITICAL_THRESHOLD=1500
NOISE_DB_WARNING_THRESHOLD=70
NOISE_DB_CRITICAL_THRESHOLD=85
TEMPERATURE_WARNING_THRESHOLD=35
TEMPERATURE_CRITICAL_THRESHOLD=39
SENSOR_RUN_ID=

MAP_CENTER_LAT=20.9446
MAP_CENTER_LNG=105.9447
MAP_DEFAULT_ZOOM=16
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=12
LLM_RESPONSE_DEADLINE_SECONDS=5
LLM_MAX_TOKENS=280
LLM_MAX_RETRIES=1

# Local Claude Code CLI via AgentRouter. Keep the real key only in ignored .env/.env.local.
AGENTROUTER_API_KEY=
# Required for Agent runtime; Claude Code itself may provide a default.
AGENTROUTER_MODEL=
AGENTROUTER_BASE_URL=https://co.agentrouter.org

# Google Gemini. With LLM_PROVIDER=auto, a configured Gemini key takes priority.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_TOKENS=32
GEMINI_RETRY_BASE_SECONDS=1
GEMINI_RETRY_MAX_SECONDS=60

AGENT_BACKEND_BASE_URL=http://localhost:8000
AGENT_SERVICE_URL=http://localhost:8001
AGENT_SERVICE_TIMEOUT_SECONDS=8
AUTO_PROPOSAL_ENABLED=true
# Empty means all stations; the spike scenario and FILTER-01 demo registry use S03.
AUTO_PROPOSAL_STATIONS=
PROPOSAL_PENDING_TTL_SECONDS=3600
VENTILATION_TRIGGER_MINUTES=15
VENTILATION_RECOVERY_MINUTES=20
VENTILATION_DEFAULT_DURATION_MINUTES=45
VENTILATION_INTENSITY_PERCENT=80
VENTILATION_MAX_GAP_SECONDS=60
AGENT_TOOL_TIMEOUT_SECONDS=3
AGENT_TOOL_MAX_RETRIES=1
REPORT_TIMEZONE=Asia/Ho_Chi_Minh
# Optional internal grounded narrative endpoint. Leave empty for deterministic report narrative.
REPORT_NARRATIVE_ENDPOINT=
REPORT_NARRATIVE_TIMEOUT_SECONDS=5
REPORT_NARRATIVE_SERVICE_TOKEN=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=3
WEATHER_LATITUDE=20.993
WEATHER_LONGITUDE=105.944
WEATHER_MAX_AGE_SECONDS=3600
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=true
CELERY_RESULT_EXPIRES=3600
JOB_PERSISTENCE_ENABLED=false
# Email Notification Provider (disabled | resend)
NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@thedung.name.vn
RESEND_FROM_NAME=AirGuard AI
RESEND_REPLY_TO=dungphamthe363@gmail.com
RESEND_TIMEOUT_SECONDS=10
VERIFICATION_TOKEN_TTL_SECONDS=600

# Bật/tắt chế độ đăng nhập nhanh (bật khi dev/demo, tắt khi lên production)
AUTH_DEMO_MODE=true
# Cấu hình Google OAuth (nếu sử dụng Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
