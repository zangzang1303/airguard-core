{
  "description": "AI20K AI usage logging",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {

            "name": "log-prompt",
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_codex_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "log-stop",
            "type": "command",
            "command": "scripts\\_pyrun.cmd scripts\\log_codex_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}